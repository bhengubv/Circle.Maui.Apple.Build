{
  "name": "circle-maui-apple",
  "displayName": "Circle MAUI Apple Build",
  "description": "Build and inspect MAUI iOS packages.",
  "publisher": "bhengubv",
  "version": "1.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bhengubv/Circle.Maui.Apple.Build.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.js",
  "categories": [
    "Other"
  ],
  "contributes": {
    "commands": [
      {
