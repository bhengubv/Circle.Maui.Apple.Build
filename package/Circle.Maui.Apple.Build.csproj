<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Circle.Maui.Apple.Build</PackageId>
    <Version>1.0.0</Version>
    <Authors>Bhengu B.V.</Authors>
    <Description>Filters desktop Whisper libraries out of .NET MAUI Apple mobile bundles.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/bhengubv/Circle.Maui.Apple.Build</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Circle.Maui.Apple.Build.targets" Pack="true" PackagePath="buildTransitive/" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
